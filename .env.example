# Copy to backend/.env and replace placeholders locally. Never commit real credentials.
PORT=4000
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@your-neon-host.neon.tech/YOUR_DATABASE?sslmode=verify-full

# Used only when DATABASE_URL is empty or omitted.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=YOUR_USER
DB_PASSWORD=YOUR_PASSWORD
DB_SSLMODE=disable

NODE_ENV=development
